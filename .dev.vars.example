# local-only secrets for `wrangler pages dev`; copy to .dev.vars (gitignored)
GEMINI_API_KEY=your-key-here
FIRECRAWL_API_KEY=your-key-here
# Notion internal integration secret (notion.so/my-integrations) — only needed
# for the Shopping List "→ Notion" button. Omit it and the button returns 501.
NOTION_TOKEN=ntn_your-token-here
